# Flask Configuration
FLASK_APP=app.app
FLASK_ENV=development
FLASK_DEBUG=true

# Server Configuration
SERVER_IP=0.0.0.0
PORT_NUMBER_FLASK=5000

# Database Configuration
DATABASE_URL=sqlite:///unraid_scripts.db

# Scheduler Configuration
SCHEDULER_TIMEZONE=UTC

# Test Data
SEED_TEST_DATA=true

# Logging
LOG_LEVEL=INFO
